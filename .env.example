# MomCitas - runtime configuration
# Copy this file to .env (which is .gitignored) and edit the values.
# docker-compose.yml reads these on `docker compose up`.

# --- PostgreSQL ---
# Used by the db service AND embedded into DATABASE_URL by docker-compose.
POSTGRES_PASSWORD=momcitas
POSTGRES_DB=momcitas

# --- App ---
# Host port mapped to the container's port 3000.
APP_PORT=3000
